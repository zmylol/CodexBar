#!/bin/zsh

set -euo pipefail

script_dir=${0:A:h}
repo_root=${script_dir:h}
bundle="$repo_root/dist/CodexBar.app"
/bin/mkdir -p "$bundle/Contents/Resources"
/usr/bin/touch "$bundle/Contents/Resources/stale-build-artifact"
"$script_dir/build-app"

[[ -x "$bundle/Contents/MacOS/CodexBar" ]]
[[ -x "$bundle/Contents/Helpers/codexbar-hook" ]]
[[ -x "$bundle/Contents/Resources/HookSetup/Install.command" ]]
/usr/bin/cmp "$bundle/Contents/Resources/HookSetup/Install.command" "$repo_root/Resources/InstallHooks.command"
for setup_script in install-hooks hook-config-common.zsh hooks-config.js; do
    /usr/bin/cmp "$bundle/Contents/Resources/HookSetup/$setup_script" "$repo_root/scripts/$setup_script"
done
[[ ! -e "$bundle/Contents/Resources/stale-build-artifact" ]]
/usr/bin/plutil -lint "$bundle/Contents/Info.plist" >/dev/null
bundle_identifier=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$bundle/Contents/Info.plist")
[[ "$bundle_identifier" == "com.codexbar.CodexBar" ]]
/usr/bin/codesign --verify --deep --strict "$bundle"

print "PASS native CodexBar.app bundle is valid and ad-hoc signed"
