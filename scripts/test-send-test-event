#!/bin/zsh

set -euo pipefail

script_dir=${0:A:h}
test_root=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/codexbar-send-event.XXXXXX")
trap '/bin/rm -rf -- "$test_root"' EXIT

export CODEXBAR_SUPPORT_ROOT="$test_root/CodexBar"
export CODEXBAR_HOOK_EXECUTABLE="${script_dir:h}/.build/debug/codexbar-hook"
workspace="$test_root/projects/project-alpha"
/bin/mkdir -p "$workspace"

"$script_dir/send-test-event" running "$workspace" "Build a test feature"
"$script_dir/send-test-event" action "$workspace"
"$script_dir/send-test-event" attention "$workspace"
"$script_dir/send-test-event" resumed "$workspace"
"$script_dir/send-test-event" ready "$workspace"

lifecycle_events=("$CODEXBAR_SUPPORT_ROOT/Inbox"/*.json(N))
activity_events=("$CODEXBAR_SUPPORT_ROOT/Activity"/*.json(N))
[[ ${#lifecycle_events} == 5 ]]
[[ ${#activity_events} == 0 ]]
/usr/bin/grep -l 'UserPromptSubmit' "$lifecycle_events[@]" >/dev/null
/usr/bin/grep -l 'PreToolUse' "$lifecycle_events[@]" >/dev/null
/usr/bin/grep -l 'PostToolUse' "$lifecycle_events[@]" >/dev/null
if /usr/bin/grep -q 'manual-swift-test' "$lifecycle_events[@]"; then
    print -u2 "Raw tool_use_id leaked into the transient activity event"
    exit 1
fi
/usr/bin/grep -l 'PermissionRequest' "$lifecycle_events[@]" >/dev/null
/usr/bin/grep -l 'Stop' "$lifecycle_events[@]" >/dev/null

if "$script_dir/send-test-event" unsupported "$workspace" >/dev/null 2>&1; then
    print -u2 "Unsupported simulated state unexpectedly succeeded"
    exit 1
fi

print "PASS send-test-event writes ordered approval and recovery fixtures without raw tool IDs"
