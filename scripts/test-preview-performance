#!/bin/zsh

set -euo pipefail

script_dir=${0:A:h}
repo_root=${script_dir:h}
cd "$repo_root"

# AppKit checks need a logged-in macOS graphical session. Keep timing observations
# separate from scripts/test: correctness assertions have no absolute speed limits.
/usr/bin/swift build --product codexbar-tests
build_dir=$(/usr/bin/swift build --show-bin-path)
check_dir=$(mktemp -d "${TMPDIR:-/tmp}/codexbar-preview-checks.XXXXXX")
trap 'rm -rf "$check_dir"' EXIT

swift_flags=(-O -swift-version 6 -target "$(uname -m)-apple-macosx13.0" -parse-as-library -I "$build_dir/Modules")
core_objects=("$build_dir"/CodexBarCore.build/*.o)

/usr/bin/swiftc "${swift_flags[@]}" "${core_objects[@]}" \
    Sources/CodexBarApp/ConversationPreviewStore.swift \
    Tests/CodexBarAppTests/ConversationPreviewStoreChecks.swift \
    -o "$check_dir/store-check"
"$check_dir/store-check"

/usr/bin/swiftc "${swift_flags[@]}" \
    Sources/CodexBarApp/ConversationPreviewScrollView.swift \
    Tests/CodexBarAppTests/PreviewScrollChecks.swift \
    -o "$check_dir/scroll-check"
"$check_dir/scroll-check"

/usr/bin/swiftc "${swift_flags[@]}" "${core_objects[@]}" \
    Sources/CodexBarApp/ConversationPreviewStore.swift \
    Sources/CodexBarApp/ConversationPreviewScrollView.swift \
    Sources/CodexBarApp/ConversationMarkdownView.swift \
    Sources/CodexBarApp/KnowledgeChangesView.swift \
    Sources/CodexBarApp/TaskDetailCard.swift \
    Tests/CodexBarAppTests/PreviewPerformanceChecks.swift \
    -o "$check_dir/performance-check"
"$check_dir/performance-check"

/usr/bin/swiftc "${swift_flags[@]}" "${core_objects[@]}" \
    Sources/CodexBarApp/ConversationPreviewStore.swift \
    Sources/CodexBarApp/ConversationPreviewScrollView.swift \
    Sources/CodexBarApp/ConversationMarkdownView.swift \
    Sources/CodexBarApp/KnowledgeChangesView.swift \
    Sources/CodexBarApp/TaskDetailCard.swift \
    Tests/CodexBarAppTests/KnowledgeReviewViewChecks.swift \
    -o "$check_dir/knowledge-view-check"
"$check_dir/knowledge-view-check"

/usr/bin/swiftc "${swift_flags[@]}" "${core_objects[@]}" \
    Sources/CodexBarApp/ConversationPreviewStore.swift \
    Sources/CodexBarApp/KnowledgeReviewStore.swift \
    Tests/CodexBarAppTests/KnowledgeReviewStoreChecks.swift \
    -o "$check_dir/knowledge-store-check"
"$check_dir/knowledge-store-check"

/usr/bin/swiftc "${swift_flags[@]}" "${core_objects[@]}" \
    Sources/CodexBarApp/KnowledgeChangesView.swift \
    Sources/CodexBarApp/VisualEffectBackground.swift \
    Sources/CodexBarApp/KnowledgeLibraryView.swift \
    Tests/CodexBarAppTests/KnowledgeLibraryViewChecks.swift \
    -o "$check_dir/knowledge-library-view-check"
"$check_dir/knowledge-library-view-check"

/usr/bin/swiftc "${swift_flags[@]}" "${core_objects[@]}" \
    Sources/CodexBarApp/KnowledgeLibraryModel.swift \
    Tests/CodexBarAppTests/KnowledgeLibraryModelChecks.swift \
    -o "$check_dir/knowledge-library-model-check"
"$check_dir/knowledge-library-model-check"

/usr/bin/swiftc "${swift_flags[@]}" "${core_objects[@]}" \
    Sources/CodexBarApp/KnowledgeLibraryModel.swift \
    Tests/CodexBarAppTests/KnowledgeLibraryPickerChecks.swift \
    -o "$check_dir/knowledge-library-picker-check"
"$check_dir/knowledge-library-picker-check"
