#!/bin/zsh

set -euo pipefail

script_dir=${0:A:h}
repo_root=${script_dir:h}

cd "$repo_root"

/usr/bin/swift build --product CodexBar
/usr/bin/swift build --product codexbar-hook
/usr/bin/swift run codexbar-tests

CODEX_INTERNAL_ORIGINATOR_OVERRIDE=codex_vscode "$script_dir/test-hook-cli"
"$script_dir/test-hook-config"
"$script_dir/test-send-test-event"
"$script_dir/test-e2e-simulated"
"$script_dir/test-app-bundle"
"$script_dir/test-install-app"

print "PASS complete CodexBar test suite"
