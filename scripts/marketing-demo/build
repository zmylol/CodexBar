#!/bin/zsh
set -euo pipefail

script_dir=${0:A:h}
repo_root=${script_dir:h:h}
cd "$repo_root"

/usr/bin/swift build --product codexbar-tests
build_dir=$(/usr/bin/swift build --show-bin-path)
demo_dir=/tmp/codexbar-marketing-demo
app_dir="$demo_dir/CodexBar Public Demo.app"
mkdir -p "$app_dir/Contents/MacOS"

cat > "$app_dir/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>dev.codexbar.marketing-demo</string>
<key>CFBundleName</key><string>CodexBar Public Demo</string>
<key>CFBundleExecutable</key><string>CodexBarPublicDemo</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>LSMinimumSystemVersion</key><string>13.0</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST

/usr/bin/swiftc -O -swift-version 6 -target "$(uname -m)-apple-macosx13.0" \
    -parse-as-library -I "$build_dir/Modules" "$build_dir"/CodexBarCore.build/*.o \
    Sources/CodexBarApp/ConversationPreviewStore.swift \
    Sources/CodexBarApp/ConversationPreviewScrollView.swift \
    Sources/CodexBarApp/ConversationMarkdownView.swift \
    Sources/CodexBarApp/KnowledgeChangesView.swift \
    Sources/CodexBarApp/TaskDetailCard.swift \
    Sources/CodexBarApp/KnowledgeLibraryView.swift \
    Sources/CodexBarApp/GitWorkspaceRowContent.swift \
    Sources/CodexBarApp/TaskListView.swift \
    "$script_dir/DemoModels.swift" "$script_dir/MarketingDemo.swift" \
    -o "$app_dir/Contents/MacOS/CodexBarPublicDemo"
/usr/bin/codesign --force --sign - "$app_dir"
print -r -- "$app_dir"
